<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0;net8.0;net462</TargetFrameworks>
		<RootNamespace>ClownFish</RootNamespace>
		<SatelliteResourceLanguages>xx</SatelliteResourceLanguages>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<LangVersion>latest</LangVersion>
		<OutputPath>bin</OutputPath>
		<DocumentationFile>bin\ClownFish.net.xml</DocumentationFile>
		<IsAotCompatible>true</IsAotCompatible>
	</PropertyGroup>

	<PropertyGroup>
		<AssemblyVersion>10.0.0.0</AssemblyVersion>
		<Version>10.26.826.1</Version>
		<FileVersion>10.26.826.1</FileVersion>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<Authors>Fish Li</Authors>
		<PackageId>ClownFish.net</PackageId>
		<Description>一个“小而美”的.NET工具类库</Description>
		<PackageProjectUrl>https://github.com/fish-li/ClownFish.net</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<!--<PropertyGroup Condition="'$(Configuration)'=='ReleaseAOT'">
		<TargetFrameworks>net10.0</TargetFrameworks>
		<DefineConstants>$(DefineConstants);IS_AOT</DefineConstants>
		<OutputPath>bin\aot\</OutputPath>
		<IsAotCompatible>true</IsAotCompatible>
		<DebugSymbols>false</DebugSymbols>
		<DocumentationFile>bin\aot\ClownFish.net.xml</DocumentationFile>
		<PackageId>ClownFish.net-aot</PackageId>
		<Description>一个“小而美”的.NET工具类库(AOT版本)</Description>
	</PropertyGroup>-->

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup Condition=" '$(TargetFramework)' == 'net45' or '$(TargetFramework)' == 'net462' or '$(TargetFramework)' == 'net48' ">
		<Reference Include="System.Web" />
		<Reference Include="System.Configuration" />
		<Reference Include="System.IO.Compression" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
		<PackageReference Include="System.ComponentModel.Annotations" Version="4.7.0" />
		<PackageReference Include="Cronos" Version="0.8.4" />
	</ItemGroup>

	<ItemGroup Condition=" '$(TargetFramework)' == 'net10.0' or '$(TargetFramework)' == 'net9.0' ">
		<PackageReference Include="Cronos" Version="0.11.1" />
		<PackageReference Include="System.CodeDom" Version="10.0.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
		<PackageReference Include="Microsoft.Extensions.ObjectPool" Version="10.0.0" />
		<PackageReference Include="Microsoft.IO.RecyclableMemoryStream" Version="3.0.1" />
	</ItemGroup>

	<ItemGroup Condition=" '$(TargetFramework)' == 'net6.0' or '$(TargetFramework)' == 'net7.0' or '$(TargetFramework)' == 'net8.0' ">
		<PackageReference Include="Cronos" Version="0.8.4" />
		<PackageReference Include="System.CodeDom" Version="8.0.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.7.0" />
		<PackageReference Include="Microsoft.Extensions.ObjectPool" Version="8.0.6" />
		<PackageReference Include="Microsoft.IO.RecyclableMemoryStream" Version="3.0.1" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="WindowsLinuxTimeZone.json" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="ClownFish.logconfig.ini" />
		<EmbeddedResource Include="WindowsLinuxTimeZone.json" />
	</ItemGroup>

</Project>
