        <Compile Include="..\ClownFish.EntityProxyGen.Tests\Models\TestDateTimeTable.cs" Link="Models\TestDateTimeTable.cs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\ClownFish.net\ClownFish.net.csproj" />
