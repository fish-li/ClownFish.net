        <Compile Include="..\ClownFish.EntityProxyGen.Tests\Models\MsSqlDataType.cs" Link="Models\MsSqlDataType.cs" />
        <Compile Include="..\ClownFish.EntityProxyGen.Tests\Models\MySqlDataType.cs" Link="Models\MySqlDataType.cs" />
